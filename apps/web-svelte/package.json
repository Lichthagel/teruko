{
  "name": "web-svelte",
  "version": "0.0.1",
  "private": true,
  "files": [
    "build"
  ],
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp lint .",
    "clean": "rm -rf .svelte-kit build"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "graphql": "catalog:",
    "server-db": "workspace:^",
    "server-env": "workspace:^",
    "server-graphql": "workspace:^",
    "sharp": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@lucide/svelte": "catalog:",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "@urql/svelte": "catalog:",
    "client-css": "workspace:*",
    "client-graphql": "workspace:*",
    "models": "workspace:*",
    "sass-embedded": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tsconfig": "workspace:*",
    "valibot": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=21.0.0"
  }
}

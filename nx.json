{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/.output",
        "{projectRoot}/build"
      ],
      "cache": true
    },
    "lint": {
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/eslint.config.js"],
      "cache": true
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/.env"],
      "cache": false
    },
    "test": {
      "cache": false
    }
  },
  "defaultBase": "main",
  "analytics": false
}

{
  "name": "teruko",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=21.0.0",
    "pnpm": ">=9.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint .",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-solid": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "tsconfig": "workspace:*",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,svelte,css,scss,md,json,yml,yaml}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  }
}

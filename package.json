{
  "name": "teruko",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "lint": "vp lint .",
    "clean": "vp run -r clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "eslint-plugin-solid": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,svelte,css,scss,md,json,yml,yaml}": "vp lint --max-warnings=0 ."
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0"
    }
  },
  "engines": {
    "node": ">=21.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
